# Local planning and research notes; keep files locally, outside Git tracking
/项目上下文.md
/当前进度.md
/决策记录.md
/参考文档/

# Machine-local credentials/configuration
.env
.env.*
!.env.example
.ssh/
*.pem
*.key
id_rsa
id_ed25519

# Compiled native Python extension (built by colcon/setuptools)
*.so
*.dylib

# Local generated releases, deployment receipts, and recovery copies
/backups/*
!/backups/COLCON_IGNORE
