build/
install/
log/
artifacts/*
!artifacts/COLCON_IGNORE
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# Local reference assets and historical experiment attachments
/历史代码/
/代码参考包/
/图片/
