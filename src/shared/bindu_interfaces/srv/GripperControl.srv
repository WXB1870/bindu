# Position control; authorize_loading is an operator declaration, not grasp evidence.
# authorize_grasp leases only the right axis; virtual/rigid select configured positions.
# These operations require stationary closed left fingers and do not prove contact/slip.
string operation
string side
string lease_id
uint64 epoch
uint64 sequence
builtin_interfaces/Time stamp
float64 valid_for
float64 position
string load_state
bool external_support
---
bool accepted
string code
