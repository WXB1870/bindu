+bool ServoNode::bindu_array(const std_msgs::msg::Float64MultiArray::SharedPtr& msg,
+                           unsigned channel, unsigned prefix) {
+    static const char* topics[] = {"ctl_data_pub", "/gripper/left_cmd", "/gripper/right_cmd",
+                                   "/head/motor_cmd", "/body/motor_cmd"};
+    bindu_guard118::Command c;
+    if (!bindu_startup_ready_ || shutdown_mode_ || channel >= bindu_pending_.size() ||
+        count_publishers(topics[channel]) != 1 ||
+        !bindu_guard118::from_array(msg->data, prefix, c) ||
+        !EtherCAT_binduCommand(channel, c, now().nanoseconds(), false)) return false;
+    if (prefix == 5 && (msg->data[1] != 0 || msg->data[2] != 0 ||
+        msg->data[3] <= 0 || msg->data[3] > 1000 || msg->data[4] < 0 || msg->data[4] > 1000)) return false;
+    if (bindu_pending_[channel].hold && !c.hold) {
+        if (channel == 1) g_left_inited = false;
+        if (channel == 2) g_right_inited = false;
+        if (channel == 3) h_inited = false;
+        if (channel == 4) t_inited = false;
+    }
+    bindu_pending_[channel] = c;
+    msg->data.resize(prefix); // strip guard tail before the existing native decoder
+    return true;
+}
+void ServoNode::bindu_publish_health() {
+    const auto t=std::chrono::steady_clock::now();
+    if (t-bindu_health_time_ < std::chrono::milliseconds(20)) return;
+    const auto data=EtherCAT_binduHealth(now().seconds(), bindu_startup_ready_ && !shutdown_mode_);
+    if (data.empty()) return;
+    std_msgs::msg::String msg; msg.data=data; bindu_health_pub_->publish(msg);
+    bindu_health_time_=t;
+}
