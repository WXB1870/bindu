+}
+bool EtherCATDriver::binduHealthy() const {
+    bindu_feedback::Snapshot s;
+    if (!inOP_.load() || !feedback_cache_.read(s) || s.valid_mask != 0xfffffu ||
+        s.expected_wkc <= 0 || s.wkc != s.expected_wkc || s.sample == 0 ||
+        s.sampled_ns <= 0 || bindu_steady_ns()-s.sampled_ns < 0 ||
+        bindu_steady_ns()-s.sampled_ns >= 20000000) return false;
+    for (auto status : s.status) if (status & 8u) return false;
+    return true;
+}
+bool EtherCATDriver::binduHeartbeat(uint64_t session, uint64_t seq, int64_t stamp, int64_t ros_now) {
+    return bindu_guard_.heartbeat(session, seq, stamp, ros_now, bindu_steady_ns(), binduHealthy());
+}
+bool EtherCATDriver::binduCommand(unsigned channel, const bindu_guard118::Command& c,
+                                int64_t ros_now, bool commit) {
+    return commit ? bindu_guard_.commit(channel, c, ros_now, bindu_steady_ns(), binduHealthy()) :
+        bindu_guard_.accepts(channel, c, ros_now, bindu_steady_ns(), binduHealthy());
+}
+std::string EtherCATDriver::binduHealthJson(double stamp, bool ready) const {
+    bindu_feedback::Snapshot s;
+    if (!feedback_cache_.read(s)) return {};
+    uint32_t fault=0, enabled=0, requested=0;
+    for (unsigned i=0; i<bindu_feedback::axes; ++i) {
+        if (s.status[i] & 8u) fault |= 1u << i;
+        if ((s.status[i] & 0x006fu) == 0x0027u) enabled |= 1u << i;
+        if (motor_enable_.load() && motor_enable_mask_[i].load()) requested |= 1u << i;
+    }
+    const double age=s.sampled_ns > 0 ? (bindu_steady_ns()-s.sampled_ns)*1e-9 : 1e9;
+    std::ostringstream out; out << std::setprecision(17) << std::boolalpha;
+    out << "{\"schema\":1,\"stamp\":" << stamp << ",\"operational\":" << inOP_.load()
+        << ",\"ready\":" << (ready && binduHealthy())
+        << ",\"sample\":" << s.sample << ",\"sample_age\":" << age
+        << ",\"wkc\":" << s.wkc << ",\"expected_wkc\":" << s.expected_wkc
+        << ",\"fault_mask\":" << fault << ",\"present_mask\":" << s.valid_mask
+        << ",\"enable_requested_mask\":" << requested << ",\"operation_enabled_mask\":" << enabled
+        << ",\"guard_enabled\":" << bindu_guard_.enabled()
+        << ",\"guard_armed\":" << bindu_guard_.armed()
+        << ",\"guard_latched\":" << bindu_guard_.latched()
+        << ",\"guard_session\":" << bindu_guard_.session()
+        << ",\"guard_hold_mask\":" << bindu_hold_mask_.load()
+        << ",\"native_position_guard_version\":1}";
+    return out.str();
+}
