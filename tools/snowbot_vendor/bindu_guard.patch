+std::string EtherCATDriver::binduHealthJson(double stamp, bool ready) const {
+    // Load the concurrent sample before reading time; the RT thread may publish
+    // a newer sample between these reads, but this age can never be negative.
+    const int64_t good_ns = last_good_pdo_ns_.load();
+    const int64_t now_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    uint32_t fault_mask = 0, enabled_mask = 0, operation_mask = 0, present_mask = 0;
+    for (int m = 0; m < 20; ++m) {
+        if ((is_csp_motor_[m] && csp_tx_[m]) || (!is_csp_motor_[m] && m_tx_[m])) present_mask |= (1u << m);
+        if ((motor_fb_status_[m].load() & 0x6f) == 0x27) operation_mask |= (1u << m);
+        if (motor_fb_status_[m].load() & 8) fault_mask |= (1u << m);
+        if (motor_enable_.load() && motor_enable_mask_[m].load()) enabled_mask |= (1u << m);
+    }
+    std::ostringstream out;
+    out << std::setprecision(17) << "{\"schema\":1,\"stamp\":" << stamp
+        << ",\"sample\":" << completed_pdo_cycles_.load()
+        << ",\"sample_age\":" << (good_ns > 0 ? (now_ns-good_ns)*1e-9 : -1.)
+        << ",\"operational\":" << (isOperational() ? "true" : "false")
+        << ",\"wkc\":" << wkc_.load() << ",\"expected_wkc\":" << expectedWKC_
+        << ",\"ready\":" << (ready ? "true" : "false")
+        << ",\"guard_enabled\":" << (bindu_guard_.enabled() ? "true" : "false")
+        << ",\"guard_session\":" << bindu_guard_.session()
+        << ",\"guard_armed\":" << (bindu_guard_.armed() ? "true" : "false")
+        << ",\"guard_latched\":" << (bindu_guard_.latched() ? "true" : "false")
+        << ",\"fault_mask\":" << fault_mask << ",\"present_mask\":" << present_mask
+        << ",\"enable_requested_mask\":" << enabled_mask
+        << ",\"operation_enabled_mask\":" << operation_mask
+        << ",\"gripper_control_enabled\":" << (bindu_grippers_enabled_.load() ? "true" : "false")
+        << ",\"gripper_latched_mask\":" << ((bindu_gripper_guard_[0].latched() ? 1 : 0) | (bindu_gripper_guard_[1].latched() ? 2 : 0))
+        << ",\"gripper_hold_mask\":" << ((bindu_gripper_hold_active_[0].load() ? 1 : 0) | (bindu_gripper_hold_active_[1].load() ? 2 : 0))
+        << ",\"gripper_hold_position\":[" << bindu_gripper_hold_position_[0].load() << "," << bindu_gripper_hold_position_[1].load() << "]"
+        << ",\"gripper_sequence\":[" << bindu_gripper_guard_[0].sequence() << "," << bindu_gripper_guard_[1].sequence() << "]}";
+    return out.str();
 }

